+            float f = scaled - i0;
+
+            return ((byte)(ramp[i0].r + (ramp[i1].r - ramp[i0].r) * f),
+                    (byte)(ramp[i0].g + (ramp[i1].g - ramp[i0].g) * f),
+                    (byte)(ramp[i0].b + (ramp[i1].b - ramp[i0].b) * f));
